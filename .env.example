# grz_domato environment example
# Copy to .env and adjust paths

# Path to Firefox source tree (needed by extract_idl.py, audit_rules.py)
FIREFOX_SRC=/home/ruslan/firefox

# Path to built Firefox binary (needed by probe_apis.py, check_reads.py, scan_cases.py)
# e.g. /home/ruslan/firefox/obj-x86_64-pc-linux-gnu/dist/bin/firefox
FIREFOX_BIN=

# Grizzly (optional) - if you run via grizzly framework
GRIZZLY_SRC=

# Headless mode for scan
MOZ_HEADLESS=1
