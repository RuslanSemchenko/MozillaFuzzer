# grz_domato environment example
# Copy to .env and adjust paths (Makefile and tools/fx_paths.py both read .env)

# Path to Firefox source tree (needed by extract_idl.py, audit_rules.py)
FIREFOX_SRC=~/firefox

# Path to built Firefox binary (needed by probe_apis.py, check_reads.py, scan_cases.py)
# e.g. ~/firefox/obj-x86_64-pc-linux-gnu/dist/bin/firefox
# Leave empty to auto-detect under $FIREFOX_SRC/obj-*/dist/bin/
FIREFOX_BIN=

# Optional: override the Python used by fuzz.sh / replay.sh / reduce.sh
# PYTHON_BIN=python3.14

# Grizzly (optional)
GRIZZLY_SRC=

# Headless mode for scan
MOZ_HEADLESS=1
